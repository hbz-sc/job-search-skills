{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tool",
    "context",
    "payload"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "tool": {
      "enum": [
        "start_run",
        "renew_run",
        "search_jobs",
        "list_jobs",
        "open_job",
        "restore_search",
        "open_chat",
        "inspect_chat",
        "read_first_phrase",
        "choose_first_phrase",
        "submit_filled_phrase",
        "inspect_send_result"
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "requestId",
        "leaseId",
        "binding",
        "deadline"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "leaseId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId",
            "tabId",
            "frameId",
            "documentId"
          ],
          "properties": {
            "sessionId": {
              "type": "string",
              "minLength": 1
            },
            "tabId": {
              "type": "integer",
              "minimum": 0
            },
            "frameId": {
              "const": 0
            },
            "documentId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tool": {
            "const": "start_run"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "maxContacts"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "search_only",
                  "greet_once",
                  "batch"
                ]
              },
              "maxContacts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "renew_run"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "search_jobs"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "city",
              "keyword"
            ],
            "properties": {
              "city": {
                "const": "深圳"
              },
              "keyword": {
                "const": "AI应用开发工程师"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "list_jobs"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "advance"
            ],
            "properties": {
              "advance": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "open_job"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "jobKey"
            ],
            "properties": {
              "jobKey": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,200}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "restore_search"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "open_chat"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "jobKey"
            ],
            "properties": {
              "jobKey": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,200}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "inspect_chat"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conversationKey"
            ],
            "properties": {
              "conversationKey": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,200}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "read_first_phrase"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conversationKey"
            ],
            "properties": {
              "conversationKey": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,200}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "choose_first_phrase"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conversationKey",
              "expectedHash"
            ],
            "properties": {
              "conversationKey": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,200}$"
              },
              "expectedHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "submit_filled_phrase"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conversationKey",
              "expectedHash"
            ],
            "properties": {
              "conversationKey": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,200}$"
              },
              "expectedHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "inspect_send_result"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conversationKey",
              "expectedHash"
            ],
            "properties": {
              "conversationKey": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,200}$"
              },
              "expectedHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  ]
}

{
  "manifest_version": 3,
  "name": "BOSS 页面诊断",
  "version": "0.8.0",
  "minimum_chrome_version": "106",
  "description": "连接已打开的 BOSS 页面，按运行范围搜索、沟通并记录每个操作阶段。",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "storage",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
